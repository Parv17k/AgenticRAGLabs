# Copy to .env. The agentship CLI, eval.py and the notebooks read it; .env is never committed.

# Any OpenAI-compatible server. Leave OPENAI_API_BASE empty to use OpenAI itself.
OPENAI_API_KEY=
OPENAI_API_BASE=
DEMO_MODEL=openai/gpt-4.1-mini          # the chat model every version uses
DEMO_REASONING_EFFORT=                  # "none" turns thinking off on hybrid reasoning models
DEMO_EMBED_MODEL=openai/text-embedding-3-small
DEMO_RERANK_MODEL=                      # a /rerank model on OPENAI_API_BASE; empty skips reranking
PRICE_AS=                               # price tokens as this model when DEMO_MODEL has no list price

# agentship serve: one local key for /v1 and Studio
AGENTSHIP_API_KEYS=[{"key":"dev-secret","user":"me","tenant":"acme","scopes":["agent:*:invoke","agents:list"]}]

# docker compose up -d: checkpoints in Postgres, traces in Phoenix (http://localhost:6006), OpenSearch for v4
AGENT_SESSION_STORE_URI=postgresql://agentship:agentship@localhost:5434/agentship
AGENTSHIP_OTEL_EXPORTERS=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
OPENSEARCH_URL=http://localhost:9200
