# Copy to .env. The agentship CLI, eval.py and the notebooks read it; .env is never committed.

# The class runs on Gemini: a key from https://aistudio.google.com/apikey, on a project with billing
# (the free tier allows 5 requests a minute; one v3 question makes 5 to 10).
GEMINI_API_KEY=
DEMO_MODEL=gemini/gemini-3.5-flash      # the chat model every version uses
DEMO_REASONING_EFFORT=none              # no thinking: faster and cheaper
DEMO_TEMPERATURE=default                # Gemini 3 wants its own default (it warns on any other)
DEMO_EMBED_MODEL=gemini/gemini-embedding-001
DEMO_RERANK_MODEL=                      # a /rerank model on OPENAI_API_BASE; empty skips reranking
PRICE_AS=                               # price tokens as this model when DEMO_MODEL has no list price

# Or any OpenAI-compatible server (leave OPENAI_API_BASE empty for OpenAI itself), with
# DEMO_MODEL=openai/<model>, DEMO_EMBED_MODEL=openai/<model> and DEMO_TEMPERATURE=0. The agent
# YAMLs name their model directly: change model: there too.
OPENAI_API_KEY=
OPENAI_API_BASE=

# agentship serve: one local key for /v1 and Studio
AGENTSHIP_API_KEYS=[{"key":"dev-secret","user":"me","tenant":"acme","scopes":["agent:*:invoke","agents:list"]}]

# docker compose up -d: checkpoints in Postgres, traces in Phoenix (http://localhost:6006), OpenSearch for lecture 2
AGENT_SESSION_STORE_URI=postgresql://agentship:agentship@localhost:5434/agentship
AGENTSHIP_OTEL_EXPORTERS=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
OPENSEARCH_URL=http://localhost:9200
